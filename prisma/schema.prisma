// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String     @id @default(cuid())
  name                String?
  email               String     @unique
  emailVerified       DateTime?
  image               String?
  school              String?
  useCase             String?
  role                String     @default("learner")
  onboardingCompleted Boolean    @default(false)
  accounts            Account[]
  sessions            Session[]
  universes           Universe[]
  uploads             Upload[]
  modelConfig         ModelConfig?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

// BYOK model connect (2026-08-13 design doc): 1:1 per-user bring-your-own-model
// config. apiKeyCiphertext/apiKeyIv are AES-256-GCM (lib/modelConfigCrypto.ts);
// the raw key is never stored or re-rendered to the client.
model ModelConfig {
  id               String    @id @default(cuid())
  userId           String    @unique
  label            String?
  baseUrl          String
  model            String
  apiKeyCiphertext String    @db.Text
  apiKeyIv         String
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model BetaSignup {
  id              String    @id @default(cuid())
  // Normalized account email (lowercased/trimmed in app code). Unique lookup key.
  email           String    @unique
  // Lifecycle state: pending | approved | revoked | redeemed.
  // pending requires manual operator approval before beta access is granted
  // (consistent with DEC-01 manual-approval decision).
  status          String    @default("pending")
  learningGoal    String?
  // Email an issued invite is bound to. When set, redemption/sign-in must
  // match this address (BETA-04 wires full OAuth redemption binding).
  invitedEmail    String?
  // SHA-256 hex hash of the raw invite token. The raw token is never stored -
  // only its hash - so a database leak cannot mint usable invite links.
  inviteTokenHash String?   @unique
  inviteExpires   DateTime?
  approvedAt      DateTime?
  redeemedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
}

// OPS-06: Beta operator audit trail. Records every approve/revoke/reinvite
// action an operator performs on a BetaSignup row (with a non-null `signupId`),
// plus admin-table add/remove actions (with a null `signupId` and the affected
// email in `targetEmail`). `operatorEmail` is the operator identity (ADMIN_EMAILS
// allowlist or Admin-table member). `ip` is the request source (x-forwarded-for),
// best-effort. Only target emails are stored, never a token or user content.
model AdminActionLog {
  id            String   @id @default(cuid())
  operatorEmail String
  action        String
  signupId      String?
  targetEmail   String
  ip            String?
  createdAt     DateTime @default(now())

  @@index([operatorEmail])
  @@index([signupId])
  @@index([action])
}

// OPS-06 round-2: operator management. `email` is unique and is another source
// of operator identity in addition to the ADMIN_EMAILS env allowlist. Operators
// may self-manage this table from the /admin UI (add/remove). Access still
// requires an approved, non-revoked BetaSignup record (tightened operator gate).
model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  // Operator email that added this admin row (auditable origin).
  addedBy   String
  createdAt DateTime @default(now())

  @@index([email])
}

model Universe {
  // Server-owned immutable row id (cuid). Never client-controlled.
  id        String   @id @default(cuid())
  // Server-owned user scoping; all reads/writes are constrained to this user.
  userId    String
  // Client-generated universe id, unique per user. Clients address their own
  // universes by this key; it is never used alone to locate a row.
  clientId  String
  data      Json
  videoUrl  String? // Cloud storage URL for video
  // Optimistic-concurrency token. Server-owned and server-incremented on every
  // write, so conflict detection is clock-skew independent (no client/server
  // clock comparison). Clients echo the version they last observed; the server
  // rejects only when the client's submitted version is older than its own.
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId])
}

model Upload {
  // Server-owned row id == the client-generated v4 uploadId (opaque, non-enumerable).
  id          String   @id
  // Server-owned user scoping; all reads/writes are constrained to this user.
  userId      String
  // Opaque, user-scoped Blob pathname derived from the uploadId. The analysis
  // route only fetches/deletes a blob whose pathname matches this row.
  pathname    String
  url         String? // Real Blob URL, populated by onUploadCompleted (server-derived).
  contentType String? // Content type reported by the Blob store.
  sizeBytes   Int? // Byte size reported by the Blob store.
  // Lifecycle: pending -> processing -> done. Expired rows are rejected by
  // the analysis route before any network I/O.
  state       String   @default("pending")
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pathname])
  @@index([userId])
}
